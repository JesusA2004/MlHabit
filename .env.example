APP_NAME="ML Habitat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Dominio canónico. En producción: APP_URL=https://mlhabitat.com.mx (sin www,
# sin barra final). Se usa en canónicas, sitemap, Open Graph y en la
# redirección 301 http→https y www→dominio (CanonicalHost, solo producción).
APP_URL=http://localhost:8000
# Pon false si el servidor web o el CDN ya redirigen www/http.
APP_CANONICAL_REDIRECT=true
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mlhabit
DB_USERNAME=root
DB_PASSWORD=

# Sesiones en base de datos: permite listar y cerrar sesiones abiertas desde
# Cuenta → Seguridad. En producción usa SESSION_ENCRYPT=true y
# SESSION_SECURE_COOKIE=true (la cookie solo viaja por HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@mlhabitat.mx"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# ML Habitat — Almacenamiento multimedia
# ---------------------------------------------------------------------------
# Proveedor activo de almacenamiento multimedia: "local" o "synology".
# El proveedor se cambia desde Administración → Almacenamiento; Synology solo
# se puede activar después de una prueba de conexión exitosa.
MEDIA_PROVIDER=local

# Límite máximo por archivo subido (en megabytes) y tamaño de fragmento (chunk)
# usado por la subida reanudable de archivos grandes.
MEDIA_MAX_UPLOAD_MB=2048
MEDIA_CHUNK_SIZE_MB=10

# Binarios de FFmpeg/FFprobe para el pipeline de procesamiento de video.
# Déjalos vacíos si FFmpeg no está instalado: el sistema lo detecta y
# deshabilita únicamente las funciones que dependen de él.
FFMPEG_BINARY_PATH=
FFPROBE_BINARY_PATH=

# ---------------------------------------------------------------------------
# ML Habitat — Synology NAS vía Tailscale (opcional)
# ---------------------------------------------------------------------------
# Valores de respaldo para el disco media_synology. Las credenciales que se
# capturan en /admin/almacenamiento se guardan cifradas en la base de datos.
# NAS_SFTP_ROOT limita la carpeta a la que la plataforma puede escribir.
# No subas IPs, usuarios ni contraseñas reales al repositorio.
NAS_SFTP_HOST=
NAS_SFTP_PORT=22
NAS_SFTP_USERNAME=
NAS_SFTP_PASSWORD=
NAS_SFTP_PRIVATE_KEY_PATH=
NAS_SFTP_ROOT=/ml-habitat

# ---------------------------------------------------------------------------
# ML Habitat — Openpay México (cobro de visitas y anticipos)
# ---------------------------------------------------------------------------
# Ver docs/pagos/OPENPAY-INTEGRACION.md. NUNCA subas llaves reales al repo.
# Sandbox: https://sandbox-dashboard.openpay.mx · Producción: https://dashboard.openpay.mx
# Merchant ID y llave pública (pk_…) se comparten con el navegador para
# tokenizar; la llave privada (sk_…) solo vive en el servidor.
OPENPAY_MERCHANT_ID=
OPENPAY_PUBLIC_KEY=
OPENPAY_PRIVATE_KEY=
# false = sandbox (sandbox-api.openpay.mx); true = producción (api.openpay.mx)
OPENPAY_PRODUCTION=false
# Credenciales HTTP Basic que capturas al registrar el webhook en el dashboard
# (URL: https://TU-DOMINIO/webhooks/openpay). Usa valores largos y aleatorios.
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASSWORD=
# 3D Secure: auto (recomendado: 3DS solo cuando el antifraude rechaza con 3005),
# always (todo cargo con 3DS) o never.
OPENPAY_3DS_MODE=auto
# Tiempo máximo de espera (segundos) por petición al API de Openpay.
OPENPAY_TIMEOUT=30

# ---------------------------------------------------------------------------
# ML Habitat — Seguridad (cabeceras HTTP, ver config/security.php)
# ---------------------------------------------------------------------------
# Content-Security-Policy. Por defecto se envía en modo Report-Only para no
# romper Openpay (openpay.js / openpay-data.js) mientras se valida el flujo de
# pago en sandbox. Cuando el navegador no reporte violaciones, pon
# CSP_ENFORCE=true. CSP_REPORT_URI es opcional (endpoint que recibe reportes).
CSP_ENABLED=true
CSP_ENFORCE=false
CSP_REPORT_URI=
# Strict-Transport-Security: solo se envía en producción sobre HTTPS.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# La verificación en dos pasos obligatoria para el equipo NO es variable de
# entorno: se activa en Administración → Configuración → Seguridad
# (security.require_2fa_for_staff, apagada por defecto).
