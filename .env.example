APP_NAME="Ml Habit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mlhabit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@mrinsight.mx"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# MR. INSIGHT — Almacenamiento multimedia
# ---------------------------------------------------------------------------
# Proveedor activo de almacenamiento multimedia: "local" o "synology".
# El proveedor "synology" queda preparado en el código pero NO debe activarse
# hasta configurar la conexión real (ver /docs/SYNOLOGY_TAILSCALE.md).
MEDIA_PROVIDER=local

# Límite máximo por archivo subido (en megabytes) y tamaño de fragmento (chunk)
# usado por la subida reanudable de archivos grandes.
MEDIA_MAX_UPLOAD_MB=2048
MEDIA_CHUNK_SIZE_MB=10

# Binarios de FFmpeg/FFprobe para el pipeline de procesamiento de video.
# Déjalos vacíos si FFmpeg no está instalado: el sistema lo detecta y
# deshabilita únicamente las funciones que dependen de él.
FFMPEG_BINARY_PATH=
FFPROBE_BINARY_PATH=

# ---------------------------------------------------------------------------
# MR. INSIGHT — Synology NAS vía Tailscale (NO CONFIGURAR AÚN)
# ---------------------------------------------------------------------------
# Estas variables se completarán en una fase posterior, cuando el NAS esté
# conectado a la red privada de Tailscale. No coloques aquí IPs, hostnames,
# usuarios ni contraseñas reales mientras tanto.
NAS_SFTP_HOST=
NAS_SFTP_PORT=22
NAS_SFTP_USERNAME=
NAS_SFTP_PASSWORD=
NAS_SFTP_PRIVATE_KEY_PATH=
NAS_SFTP_ROOT=/mr-insight
